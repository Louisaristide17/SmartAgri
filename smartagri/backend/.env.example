# ─── Copier ce fichier en .env et renseigner les valeurs ───────────

# Base de données (SQLite par défaut, PostgreSQL en production)
DATABASE_URL=sqlite:///./smartagri.db
# DATABASE_URL=postgresql://user:password@localhost:5432/smartagri

# Sécurité JWT (changer en production !)
SECRET_KEY=smartagri-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API OpenWeatherMap (clé gratuite sur openweathermap.org)
OPENWEATHER_API_KEY=

# API OpenAI (pour AgriBot GPT — optionnel)
OPENAI_API_KEY=

# Agent IA réel AgriBot (Groq, gratuit) — à mettre UNIQUEMENT dans les variables d'environnement Render, jamais dans Git
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek (agent IA, essayé en premier si la clé est présente) — variables Render uniquement
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# LLM_PROVIDER=deepseek   # ou groq : fournisseur à essayer en premier

# Claude (Anthropic) — clé d'API de console.anthropic.com (commence par sk-ant-api03-), variables Render uniquement
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
